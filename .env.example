# Environment Configuration
ENVIRONMENT=development
DEBUG=False

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_TIMEOUT=60

# Browser Settings
# ArchitectOS launches your INSTALLED Google Chrome, not a bundled
# Chromium. Chrome is detected automatically; set CHROME_PATH only if
# detection fails.
BROWSER_MODE=auto
# Dedicated Chrome profile, stored at DATA_DIR/chrome-profile/<name>.
# Never your normal browsing profile. Persists across restarts and is
# only removed by /reset-profile.
AUTOMATION_PROFILE=ArchitectOS
# Open Chrome maximized with normal browser UI.
BROWSER_MAXIMIZED=true
REMOTE_DEBUG_PORT=9222
CHROME_PATH=
HEADLESS=
TYPING_DELAY=40
ATTACH_TIMEOUT=5
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30
BROWSER_VIEWPORT_WIDTH=1920
BROWSER_VIEWPORT_HEIGHT=1080

# Ollama/Brain Settings
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Read timeout for long generations (synthesis, decomposition).
OLLAMA_TIMEOUT=120
# Read timeout for short structured calls (classification, routing).
# These are token-capped, so they must fail fast rather than hang.
OLLAMA_FAST_TIMEOUT=25
# TCP connect timeout: an unreachable server should fail immediately.
OLLAMA_CONNECT_TIMEOUT=5
# Context window passed to the model.
OLLAMA_NUM_CTX=4096
# Keep the model resident so requests do not pay model load cost.
OLLAMA_KEEP_ALIVE=10m
# Allow thinking models (qwen3) to emit a reasoning preamble.
# Leave false: it multiplies latency for answers that are a few tokens.
OLLAMA_THINK=false
# Generation caps. Classification needs only a tiny JSON object.
OLLAMA_CLASSIFY_TOKENS=64
OLLAMA_DECOMPOSE_TOKENS=400
# Cached complexity verdicts held in memory.
CLASSIFICATION_CACHE_SIZE=256

# Logging Settings
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Storage Settings
DATA_DIR=data
CACHE_DIR=.cache
STATE_PERSISTENCE=true

# Timeout Settings
DEFAULT_TIMEOUT=30
BROWSER_LAUNCH_TIMEOUT=60
INFERENCE_TIMEOUT=120

# Retry Settings
MAX_RETRIES=3
RETRY_DELAY=1.0
RETRY_BACKOFF_MULTIPLIER=2.0

# Provider Settings
# Providers kept open in the persistent session, in tab-open order.
# Available: chatgpt, claude, gemini, grok, deepseek, perplexity,
# mistral, qwen. Unknown names are ignored; providers that fail to start
# are skipped. Leave empty to enable everything that ships enabled.
# Only chatgpt has selectors verified in this codebase, so start small
# and add providers once each one is confirmed working.
ENABLED_PROVIDERS=chatgpt,gemini,grok,claude,deepseek

# Providers that must never launch, be monitored, be recovered, or
# appear in consensus. This list always wins over ENABLED_PROVIDERS.
# Empty by default: every provider now runs on the shared authentication
# lifecycle, so a provider needing sign-in or human verification is
# paused for manual action rather than disabled.
DISABLED_PROVIDERS=
# Run local-model synthesis over gathered answers. Off keeps the fast
# path free of inference latency; consensus still combines the answers.
RESEARCH_SYNTHESIZE=false
# Per-provider timeout for a single prompt.
PROVIDER_TIMEOUT=180

# Authentication.
# ArchitectOS NEVER stores usernames, passwords, API keys, or OAuth
# tokens — not in code, not here, not in any environment variable.
# Sessions live only inside the persistent Chrome profile under
# DATA_DIR/chrome-profiles/. You sign in manually once per provider; the
# session then survives restarts. /reset-profile is the only operation
# that removes authentication.
# How long to wait for a manual sign-in before pausing that provider.
# Set to 0 to pause immediately instead of waiting.
LOGIN_WAIT_SECONDS=180
# Seconds between checks while waiting for a manual sign-in.
LOGIN_POLL_SECONDS=3
# Seconds between provider health checks. 0 disables monitoring and
# automatic per-tab recovery.
SESSION_MONITOR_INTERVAL=60
# Approximate character budget per provider conversation before it is
# reset automatically. 0 never resets.
CONVERSATION_CONTEXT_CHARS=120000
# Launch the browser and open all provider tabs during startup instead
# of on the first research request.
OPEN_SESSION_ON_START=false

# Debate Settings
DEBATE_ENABLED=true
DEBATE_MAX_ROUNDS=3
# Consensus confidence at which debate stops early.
DEBATE_CONFIDENCE_THRESHOLD=0.8

# Consensus Settings
CONSENSUS_ENABLED=true
CONSENSUS_MIN_AGENTS=2
CONSENSUS_THRESHOLD=0.51

# Feature Flags
VERBOSE_LOGGING=false
PERFORMANCE_TRAC
# Desktop Experience
AUTO_HIDE_BROWSER=true
RESEARCH_FRESH_CONVERSATION=false
FINAL_ANSWER_SYNTHESIS=true

# Research Engine
# 'operator' plans each request into subtasks and distributes them across
# providers; 'debate' asks everyone the same question (previous behaviour).
RESEARCH_MODE=operator
RESEARCH_PLANNING=true
